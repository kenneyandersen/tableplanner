@* Draws one floor as SVG and lets the user select, drag and resize its tables and elements.
   Coordinates in the SVG are metres; Scale is pixels per metre. All changes go through History. *@
@inject IJSRuntime JS
@using static TablePlanner.Web.Formatting

@if (Floor is { } floor)
{
    var (width, height) = Extent(floor);
    <svg @ref="_svg" class="floor-canvas" width="@Svg(width * Scale)" height="@Svg(height * Scale)" viewBox="0 0 @Svg(width) @Svg(height)"
         @onpointerdown="OnBackgroundDown" @onpointermove="OnPointerMove" @onpointerup="OnPointerUp" @onpointercancel="OnPointerUp">
        <defs>
            <pattern id="grid-minor" width="@Svg(Grid.DefaultStep)" height="@Svg(Grid.DefaultStep)" patternUnits="userSpaceOnUse">
                <path d="M @Svg(Grid.DefaultStep) 0 L 0 0 0 @Svg(Grid.DefaultStep)" class="grid-minor" />
            </pattern>
            <pattern id="grid-major" width="5" height="5" patternUnits="userSpaceOnUse">
                <rect width="5" height="5" fill="url(#grid-minor)" />
                <path d="M 5 0 L 0 0 0 5" class="grid-major" />
            </pattern>
        </defs>
        <rect width="@Svg(width)" height="@Svg(height)" fill="url(#grid-major)" />

        @foreach (var element in floor.Elements)
        {
            var bounds = FloorElementGeometry.GetBounds(element);
            var id = element.Id;
            <g class="item element kind-@element.Kind.ToString().ToLowerInvariant() @(Selection.Contains(id) ? "selected" : "")"
               @onpointerdown="e => OnItemDown(e, id)" @onpointerdown:stopPropagation="true">
                <rect x="@Svg(bounds.Left)" y="@Svg(bounds.Top)" width="@Svg(bounds.Width)" height="@Svg(bounds.Height)" rx="0.05" />
                <text x="@Svg(element.X)" y="@Svg(element.Y)" font-size="@Svg(Math.Min(0.45, Math.Min(bounds.Height, bounds.Width) * 0.45))">@element.Label</text>
            </g>
        }

        @foreach (var table in floor.Tables)
        {
            var bounds = TableGeometry.GetBounds(table);
            var id = table.Id;
            var selected = Selection.Contains(id);
            <g class="item table @(selected ? "selected" : "")" @onpointerdown="e => OnItemDown(e, id)" @onpointerdown:stopPropagation="true">
                <rect x="@Svg(bounds.Left)" y="@Svg(bounds.Top)" width="@Svg(bounds.Width)" height="@Svg(bounds.Height)" rx="0.05" />
                @foreach (var seat in TableGeometry.GetSeats(table))
                {
                    var index = seat.Id.Index;
                    var editable = EditSeats && selected;
                    <circle cx="@Svg(seat.Position.X)" cy="@Svg(seat.Position.Y)" r="0.2"
                            class="seat @(seat.IsDisabled ? "disabled" : "") @(editable ? "editable" : "")"
                            @onpointerdown="e => OnSeatDown(e, id, index)" @onpointerdown:stopPropagation="editable" />
                    @if (seat.IsDisabled)
                    {
                        <path d="M @Svg(seat.Position.X - 0.12) @Svg(seat.Position.Y - 0.12) l 0.24 0.24 m 0 -0.24 l -0.24 0.24" class="seat-cross" />
                    }
                }
                <text x="@Svg(table.X)" y="@Svg(table.Y)" font-size="@Svg(Math.Min(0.4, Math.Min(bounds.Width, bounds.Height) * 0.6))">@table.Number</text>
            </g>
        }

        @* Drawn last, so neighbouring tables can't cover it. *@
        @if (Selection.Count == 1 && !EditSeats && floor.Tables.FirstOrDefault(t => Selection.Contains(t.Id)) is { } resizable)
        {
            var handle = ResizeHandle(resizable);
            var id = resizable.Id;
            <rect class="resize-handle" x="@Svg(handle.X - HandleSize / 2)" y="@Svg(handle.Y - HandleSize / 2)" width="@Svg(HandleSize)" height="@Svg(HandleSize)"
                  @onpointerdown="e => OnHandleDown(e, id)" @onpointerdown:stopPropagation="true">
                <title>Drag to add or remove seats</title>
            </rect>
        }
    </svg>
}

@code {
    private enum DragMode { None, Move, Resize }

    private ElementReference _svg;
    private DragMode _mode;
    private double _startClientX, _startClientY;
    private Dictionary<Guid, (double X, double Y)> _startPositions = [];
    private Guid _resizeTableId;
    private int _startSeatsPerSide;
    private PendingEdit? _pending;

    [Parameter, EditorRequired] public EditHistory History { get; set; } = default!;
    [Parameter, EditorRequired] public Guid FloorId { get; set; }
    [Parameter, EditorRequired] public IReadOnlySet<Guid> Selection { get; set; } = default!;
    [Parameter] public EventCallback<IReadOnlySet<Guid>> SelectionChanged { get; set; }

    /// <summary>Pixels per metre.</summary>
    [Parameter] public double Scale { get; set; } = 40;

    /// <summary>When on, clicking a seat of the selected table disables or enables it.</summary>
    [Parameter] public bool EditSeats { get; set; }

    private Floor? Floor => History.Project.Setup.Floors.FirstOrDefault(f => f.Id == FloorId);

    /// <summary>The drawing area: the floor's contents plus a margin, at least 30 × 20 m.</summary>
    private static (double Width, double Height) Extent(Floor floor)
    {
        var bounds = floor.Tables.Select(TableGeometry.GetBounds).Concat(floor.Elements.Select(FloorElementGeometry.GetBounds)).ToList();
        var right = bounds.Count == 0 ? 0 : bounds.Max(b => b.Right);
        var bottom = bounds.Count == 0 ? 0 : bounds.Max(b => b.Bottom);
        return (Math.Max(30, Math.Ceiling(right) + 5), Math.Max(20, Math.Ceiling(bottom) + 5));
    }

    private const double HandleSize = 0.3;

    /// <summary>
    /// The handle sits against the table's right end (in the table's own frame), within the narrow gap
    /// usually left between tables placed end to end.
    /// </summary>
    private static Point ResizeHandle(Table table) =>
        new Point(table.Length / 2 + HandleSize / 2 + 0.02, 0).Rotate(table.Rotation).Offset(table.X, table.Y);

    private async Task OnItemDown(PointerEventArgs e, Guid id)
    {
        if (e.Button != 0)
            return;

        if (e.ShiftKey || e.CtrlKey)
        {
            var toggled = new HashSet<Guid>(Selection);
            if (!toggled.Remove(id))
                toggled.Add(id);
            await SelectionChanged.InvokeAsync(toggled);
            return;
        }

        var selection = Selection.Contains(id) ? Selection : new HashSet<Guid> { id };
        if (!ReferenceEquals(selection, Selection))
            await SelectionChanged.InvokeAsync(selection);

        var floor = Floor!;
        _startPositions = floor.Tables.Where(t => selection.Contains(t.Id)).Select(t => (t.Id, (t.X, t.Y)))
            .Concat(floor.Elements.Where(el => selection.Contains(el.Id)).Select(el => (el.Id, (el.X, el.Y))))
            .ToDictionary(x => x.Item1, x => x.Item2);
        await BeginDrag(e, DragMode.Move);
    }

    private async Task OnHandleDown(PointerEventArgs e, Guid tableId)
    {
        if (e.Button != 0)
            return;
        _resizeTableId = tableId;
        _startSeatsPerSide = History.Project.Setup.FindTable(tableId)!.SeatsPerSide;
        await BeginDrag(e, DragMode.Resize);
    }

    private void OnSeatDown(PointerEventArgs e, Guid tableId, int index)
    {
        if (EditSeats && Selection.Contains(tableId))
            History.Execute("Toggle seat", p => SetupOperations.ToggleSeatDisabled(p, tableId, index));
    }

    private async Task BeginDrag(PointerEventArgs e, DragMode mode)
    {
        _mode = mode;
        _startClientX = e.ClientX;
        _startClientY = e.ClientY;
        _pending = History.BeginEdit();
        await JS.InvokeVoidAsync("tablePlanner.capturePointer", _svg, e.PointerId);
    }

    private async Task OnBackgroundDown(PointerEventArgs e)
    {
        if (e.Button == 0 && !e.ShiftKey && !e.CtrlKey && Selection.Count > 0)
            await SelectionChanged.InvokeAsync(new HashSet<Guid>());
    }

    private void OnPointerMove(PointerEventArgs e)
    {
        if (_mode == DragMode.None || Floor is not { } floor)
            return;

        var dx = (e.ClientX - _startClientX) / Scale;
        var dy = (e.ClientY - _startClientY) / Scale;

        if (_mode == DragMode.Move)
        {
            // Snap the movement (not each position), so a group of items keeps its arrangement. Alt = no snapping.
            if (!e.AltKey)
            {
                dx = Grid.Snap(dx);
                dy = Grid.Snap(dy);
            }
            foreach (var table in floor.Tables.Where(t => _startPositions.ContainsKey(t.Id)))
                (table.X, table.Y) = (_startPositions[table.Id].X + dx, _startPositions[table.Id].Y + dy);
            foreach (var element in floor.Elements.Where(el => _startPositions.ContainsKey(el.Id)))
                (element.X, element.Y) = (_startPositions[element.Id].X + dx, _startPositions[element.Id].Y + dy);
        }
        else if (History.Project.Setup.FindTable(_resizeTableId) is { } table)
        {
            var axis = new Point(1, 0).Rotate(table.Rotation);
            var alongTable = dx * axis.X + dy * axis.Y;
            var seats = Math.Max(1, _startSeatsPerSide + (int)Math.Round(alongTable / table.SeatSpacing));
            SetupOperations.ResizeTable(History.Project, table.Id, seats, table.EndSeats);
        }
    }

    private void OnPointerUp(PointerEventArgs e)
    {
        if (_mode == DragMode.None)
            return;
        var description = _mode == DragMode.Move ? (_startPositions.Count == 1 ? "Move item" : "Move items") : "Resize table";
        _mode = DragMode.None;
        _pending?.Commit(description);
        _pending = null;
    }
}
