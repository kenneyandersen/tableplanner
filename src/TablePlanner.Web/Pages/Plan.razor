@page "/project/{Id:guid}/plan"
@implements IDisposable
@inject ProjectSession Session
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@using TablePlanner.Core.Serialization
@using TablePlanner.Solver

<PageTitle>Plan · Table Planner</PageTitle>

<ProjectLoader Id="Id">
    @if (CurrentFloor is not { } floor)
    {
        <MudContainer MaxWidth="MaxWidth.Small" Class="py-8">
            <MudText Class="mb-2">This project has no floors or tables yet.</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="@($"project/{Id}/layout")">Set up the layout</MudButton>
        </MudContainer>
    }
    else
    {
        var setup = Session.Project!.Setup;
        var summary = DisplayedSummary;
        <div class="editor-page">
            <MudToolBar Dense="true" Class="editor-toolbar" WrapContent="true">
                <MudToggleGroup T="Guid" Value="floor.Id" ValueChanged="@(id => _floorId = id)" Size="Size.Small" Color="Color.Primary">
                    @foreach (var f in setup.Floors)
                    {
                        <MudToggleItem Value="f.Id" Text="@f.Name" />
                    }
                </MudToggleGroup>

                <MudDivider Vertical="true" FlexItem="true" Class="mx-2" />

                @if (_running)
                {
                    <div class="solver-progress">
                        <MudProgressLinear Color="Color.Primary" Value="@((_progress?.Fraction ?? 0) * 100)" />
                        <MudText Typo="Typo.caption">
                            Searching… @(_progress is { } p ? $"{p.Iterations:N0} plans tried, {p.Elapsed.TotalSeconds:0} of {p.TimeBudget.TotalSeconds:0} s" : "")
                        </MudText>
                    </div>
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Stop" OnClick="Cancel" Class="ml-2">Stop</MudButton>
                }
                else
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AutoAwesome"
                               OnClick="@(() => Solve(SolveMode.Fresh))">Make plan</MudButton>
                    <MudTooltip Text="Improve the current plan while moving as few people as possible to other tables">
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Tune" Class="ml-2"
                                   Disabled="Session.Project.CurrentAssignment.Seats.Count == 0" OnClick="@(() => Solve(SolveMode.KeepCloseToCurrent))">Re-optimize</MudButton>
                    </MudTooltip>
                    <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Settings" Class="ml-2" OnClick="EditPriorities">Priorities</MudButton>
                    <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.ClearAll" Class="ml-2"
                               Disabled="Session.Project.CurrentAssignment.Seats.Count == 0" OnClick="ClearPlan">Clear plan</MudButton>
                    <MudMenu Label="Locks" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Lock" Class="ml-2" Disabled="_proposal is not null">
                        <MudMenuItem OnClick="LockAll" Disabled="Session.Project.CurrentAssignment.Seats.Count == 0">Lock all seated groups</MudMenuItem>
                        <MudMenuItem OnClick="UnlockAll" Disabled="!setup.Pins.Any(p => p.Scope == PinScope.Seats)">Unlock all</MudMenuItem>
                    </MudMenu>
                }

                <MudSpacer />

                <MudTooltip Text="Zoom out">
                    <MudIconButton Icon="@Icons.Material.Filled.ZoomOut" Disabled="_scale <= MinScale" OnClick="@(() => Zoom(-10))" aria-label="Zoom out" />
                </MudTooltip>
                <MudText Typo="Typo.caption">@((int)(_scale / DefaultScale * 100))%</MudText>
                <MudTooltip Text="Zoom in">
                    <MudIconButton Icon="@Icons.Material.Filled.ZoomIn" Disabled="_scale >= MaxScale" OnClick="@(() => Zoom(10))" aria-label="Zoom in" />
                </MudTooltip>
            </MudToolBar>

            <div class="editor-body">
                <div class="editor-canvas" tabindex="0" @onkeydown="OnKeyDown">
                    @if (_moving && SelectedGroup is { } moving)
                    {
                        <MudChip T="string" Color="Color.Primary" Class="move-hint" OnClose="@(() => _moving = false)">
                            Click a seat to move @moving.Name there, or another group's seat to swap. Esc cancels.
                        </MudChip>
                    }
                    <PlanCanvas Setup="setup" FloorId="floor.Id" Assignment="DisplayedAssignment" Colours="_colours" Scale="_scale" BackgroundUrl="@Session.ImageUrl(floor.Background?.ImageId)"
                                Selected="_highlight" Pinned="_pinned" MoveMode="_moving" SeatClicked="OnSeatClicked" GroupClicked="HighlightGroup"
                                DragEnabled="_proposal is null" DropPreview="DropPreview" GroupDropped="OnGroupDropped" ListDrag="_listDrag" />
                </div>
                <div class="editor-side">
                    @if (_failure is { } failure)
                    {
                        <MudAlert Severity="Severity.Error" Dense="true" ShowCloseIcon="true" CloseIconClicked="@(() => _failure = null)">
                            No plan could be made.
                            <ul class="message-list">
                                @foreach (var issue in failure.Take(8))
                                {
                                    <li>@issue.Message</li>
                                }
                            </ul>
                        </MudAlert>
                    }
                    @if (_proposal is not null && _proposalSummary is { } proposed)
                    {
                        <MudPaper Outlined="true" Class="pa-3 proposal">
                            <MudText Typo="Typo.subtitle1">New plan</MudText>
                            <MudText Typo="Typo.body2" Class="mb-2">
                                Shown on the left. @(Session.Project.CurrentAssignment.Seats.Count > 0 ? "It replaces the current plan when you use it." : "")
                                Found in @_proposal.Elapsed.TotalSeconds.ToString("0.0") s after trying @_proposal.Iterations.ToString("N0") plans.
                            </MudText>
                            @if (_currentSummary is { PeoplePlaced: > 0 } current)
                            {
                                <MudText Typo="Typo.body2" Class="mb-2">
                                    Score @proposed.Score.ToString("N0") (current plan: @current.Score.ToString("N0")).
                                </MudText>
                            }
                            <MudStack Row="true" Spacing="2">
                                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Accept">Use this plan</MudButton>
                                <MudButton Variant="Variant.Text" OnClick="@(() => (_proposal, _proposalSummary) = (null, null))">Discard</MudButton>
                            </MudStack>
                        </MudPaper>
                    }

                    @if (SelectedGroup is { } selected)
                    {
                        <GroupDetailPanel Group="selected" Setup="setup" Assignment="DisplayedAssignment" Colour="@_colours.GetValueOrDefault(selected.Id, "#ccc")"
                                          Placement="summary?.Groups.FirstOrDefault(g => g.GroupId == selected.Id)" Moving="_moving" Disabled="_proposal is not null"
                                          OnMove="@(() => _moving = !_moving)" OnLock="@(() => Edit("Lock group", p => PlanOperations.Lock(p, selected.Id)))"
                                          OnUnpin="@(() => Edit("Remove pin", p => PlanOperations.Unpin(p, selected.Id)))"
                                          OnPinTable="@(t => Edit("Pin group to table", p => PlanOperations.PinToTable(p, selected.Id, t)))"
                                          OnPinFloor="@(f => Edit("Pin group to floor", p => PlanOperations.PinToFloor(p, selected.Id, f)))"
                                          OnUnseat="@(() => Edit("Take group out of plan", p => PlanOperations.UnseatGroup(p, selected.Id)))"
                                          OnClose="@(() => HighlightGroup(null))" />
                    }

                    @if (summary is not null)
                    {
                        <MudTabs Elevation="0" Rounded="true" TabPanelsClass="pt-2" Class="side-tabs" MinimumTabWidth="70px" @bind-ActivePanelIndex="_tab">
                            <MudTabPanel Text="Groups">
                                <PlanSummaryPanel Summary="summary" Colours="_colours" Pinned="_pinned" Highlight="_highlight" HighlightChanged="HighlightGroup"
                                                  DragEnabled="_proposal is null" DragStarted="@(id => _listDrag = id)" DragEnded="@(() => _listDrag = null)" />
                            </MudTabPanel>
                            <MudTabPanel Text="Tables">
                                <TablesPanel Setup="setup" Assignment="DisplayedAssignment" GroupClicked="HighlightGroup" />
                            </MudTabPanel>
                            <MudTabPanel Text="Saved plans">
                                <SavedPlansPanel Project="Session.Project" CanSave="@(Session.Project.CurrentAssignment.Seats.Count > 0)"
                                                 OnSave="SavePlan" OnRestore="RestorePlan" OnDelete="DeletePlan"
                                                 OnRename="@(x => Edit("Rename saved plan", p => PlanOperations.RenamePlan(p, x.Id, x.Name)))" />
                            </MudTabPanel>
                        </MudTabs>
                    }
                </div>
            </div>
        </div>
    }
</ProjectLoader>

@code {
    private const double DefaultScale = 40, MinScale = 15, MaxScale = 100;

    private Guid _floorId;
    private double _scale = DefaultScale;
    private Guid? _highlight;
    private bool _moving;
    private SeatingProblem? _problem;

    /// <summary>The group being dragged from the list, while it is.</summary>
    private Guid? _listDrag;
    private int _tab;
    private IReadOnlySet<Guid> _pinned = new HashSet<Guid>();
    private IReadOnlyDictionary<Guid, string> _colours = new Dictionary<Guid, string>();
    private PlanSummary? _currentSummary;

    private bool _running;
    private CancellationTokenSource? _cancel;
    private SolveProgress? _progress;
    private SolveResult? _proposal;
    private PlanSummary? _proposalSummary;
    private IReadOnlyList<PlanIssue>? _failure;

    [Parameter] public Guid Id { get; set; }

    private Floor? CurrentFloor =>
        Session.Project?.Setup.Floors.FirstOrDefault(f => f.Id == _floorId) ?? Session.Project?.Setup.Floors.FirstOrDefault();

    /// <summary>The proposed plan while there is one, otherwise the current plan.</summary>
    private SeatingAssignment DisplayedAssignment => _proposal?.Assignment ?? Session.Project!.CurrentAssignment;

    private PlanSummary? DisplayedSummary => _proposalSummary ?? _currentSummary;

    protected override void OnInitialized()
    {
        Session.Changed += OnSessionChanged;
        Refresh();
    }

    public void Dispose()
    {
        Session.Changed -= OnSessionChanged;
        _cancel?.Cancel();
    }

    private void OnSessionChanged()
    {
        Refresh();
        InvokeAsync(StateHasChanged);
    }

    /// <summary>Recomputes colours and the summary of the current plan after any change to the project.</summary>
    private void Refresh()
    {
        if (Session.Project is not { } project)
            return;
        _colours = GroupColours.For(project.Setup);
        _pinned = project.Setup.Pins.Select(p => p.GroupId).ToHashSet();
        _problem = null;
        if (_highlight is { } id && project.Setup.FindGroup(id) is null)
            (_highlight, _moving) = (null, false);
        _currentSummary = Summarize(project.CurrentAssignment);
        _proposalSummary = _proposal?.Assignment is { } proposed ? Summarize(proposed) : null;
    }

    /// <summary>Scores a plan against the project as it is now, the same way for the current and the proposed plan.</summary>
    private PlanSummary Summarize(SeatingAssignment assignment)
    {
        var project = Session.Project!;
        var problem = SeatingProblem.Create(project.Setup, project.Priorities);
        return new PlanEvaluator(problem).Summarize(problem.ToPlan(assignment));
    }

    private async Task Solve(SolveMode mode)
    {
        // The solver works on a copy, so edits elsewhere in the app during the search don't interfere.
        var copy = ProjectSerializer.Deserialize(ProjectSerializer.Serialize(Session.Project!)).Project!;
        _cancel = new CancellationTokenSource();
        _running = true;
        _failure = null;
        (_proposal, _proposalSummary) = (null, null);
        _progress = null;
        var progress = new Progress<SolveProgress>(p =>
        {
            _progress = p;
            InvokeAsync(StateHasChanged);
        });

        try
        {
            var result = await SeatingSolver.SolveAsync(copy, new SolverOptions { Mode = mode }, progress, _cancel.Token);
            if (result.Status == SolveStatus.Failed)
                _failure = result.Issues;
            else
                (_proposal, _proposalSummary) = (result, Summarize(result.Assignment!));
        }
        catch (Exception ex)
        {
            _failure = [new PlanIssue(Core.Validation.IssueSeverity.Error, $"Something went wrong: {ex.Message}")];
        }
        finally
        {
            _running = false;
            _cancel.Dispose();
            _cancel = null;
        }
    }

    private void Cancel() => _cancel?.Cancel();

    private void Accept()
    {
        var assignment = _proposal!.Assignment!;
        (_proposal, _proposalSummary) = (null, null);
        Session.History!.Execute("Make plan", p => p.CurrentAssignment = assignment);
        Snackbar.Add("The new plan is now the current plan.", Severity.Success);
    }

    private async Task ClearPlan()
    {
        var confirm = await Dialogs.ShowMessageBoxAsync("Clear plan?", "Remove everyone from their seats? You can undo this.",
            yesText: "Clear", cancelText: "Cancel");
        if (confirm == true)
            Session.History!.Execute("Clear plan", p => p.CurrentAssignment = new SeatingAssignment());
    }

    private async Task EditPriorities()
    {
        var parameters = new DialogParameters<PrioritiesDialog> { { x => x.Priorities, Session.Project!.Priorities } };
        var dialog = await Dialogs.ShowAsync<PrioritiesDialog>("Priorities", parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        if (await dialog.Result is { Canceled: false, Data: SeatingPriorities edited })
            Session.History!.Execute("Change priorities", p => p.Priorities = edited);
    }

    private Group? SelectedGroup => _highlight is { } id ? Session.Project?.Setup.FindGroup(id) : null;

    /// <summary>Runs an edit on the current plan or pins as one undoable step.</summary>
    private void Edit(string description, Action<EventProject> edit) => Session.History!.Execute(description, edit);

    /// <summary>Selects a group via a click on a seat or, while moving, moves or swaps the selected group there.</summary>
    private void OnSeatClicked(SeatId seat)
    {
        if (!_moving || SelectedGroup is not { } group || _proposal is not null)
        {
            HighlightGroup(DisplayedAssignment.GroupAt(seat));
            return;
        }
        if (PlaceGroup(group, seat))
            _moving = false;
    }

    /// <summary>A group dragged onto a seat: moved there, or swapped with the group sitting there.</summary>
    private void OnGroupDropped((Guid GroupId, SeatId Seat) drop)
    {
        if (_proposal is not null || Session.Project!.Setup.FindGroup(drop.GroupId) is not { } group)
            return;
        if (PlaceGroup(group, drop.Seat))
        {
            _highlight = group.Id;
            _moving = false;
        }
    }

    /// <summary>The seating problem for the current setup, made once per change: drag previews ask for it often.</summary>
    private SeatingProblem Problem => _problem ??= SeatingProblem.Create(Session.Project!.Setup, Session.Project.Priorities);

    /// <summary>
    /// Where <paramref name="groupId"/> would sit if placed at <paramref name="seat"/>: the other group's seats (and more
    /// or fewer) for a swap, a block of free seats from there for a move. Null when it does not fit.
    /// </summary>
    private IReadOnlyCollection<SeatId>? DropPreview(Guid groupId, SeatId seat)
    {
        var assignment = Session.Project!.CurrentAssignment;
        if (assignment.GroupAt(seat) is { } other && other != groupId)
            return PlanEditing.SeatsForSwap(Problem, assignment, groupId, other)[groupId];
        return PlanEditing.SeatsForMove(Problem, assignment, groupId, seat);
    }

    /// <summary>Moves a group to a seat or swaps it with the group there, as one undoable step. False when it does not fit.</summary>
    private bool PlaceGroup(Group group, SeatId seat)
    {
        var project = Session.Project!;
        if (project.CurrentAssignment.GroupAt(seat) is { } other && other != group.Id)
        {
            var swap = PlanEditing.SeatsForSwap(Problem, project.CurrentAssignment, group.Id, other);
            Edit("Swap groups", p => PlanOperations.SeatGroups(p, swap));
            return true;
        }
        if (PlanEditing.SeatsForMove(Problem, project.CurrentAssignment, group.Id, seat) is { } seats)
        {
            Edit("Move group", p => PlanOperations.SeatGroups(p, new Dictionary<Guid, IReadOnlyList<SeatId>> { [group.Id] = seats }));
            return true;
        }
        Snackbar.Add($"There are not enough free seats on this floor for {group.Name} ({group.PeopleCount}). Drop it on a seat of another group to swap instead.", Severity.Warning);
        return false;
    }

    private void OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
            _moving = false;
        else if (e.Key is "m" or "M" && SelectedGroup is not null && _proposal is null)
            _moving = !_moving;
    }

    private void LockAll()
    {
        var count = 0;
        Edit("Lock all groups", p => count = PlanOperations.LockAll(p));
        Snackbar.Add($"{count} groups locked to their seats.", Severity.Info);
    }

    private void UnlockAll() => Edit("Unlock all groups", p => PlanOperations.UnlockAll(p));

    private void SavePlan(string name)
    {
        var s = _currentSummary!;
        var first = s.PreferenceStats.FirstOrDefault(x => x.Rank == 1);
        var stats = new PlanStats(s.Score, s.PeoplePlaced, s.PeopleTotal, s.SplitGroups, first?.Met ?? 0, first?.Wanted ?? 0);
        SavedAssignment? saved = null;
        Edit("Save plan", p => saved = PlanOperations.SavePlan(p, name, DateTimeOffset.Now, stats));
        Snackbar.Add($"Saved '{saved!.Name}'.", Severity.Success);
    }

    private void RestorePlan(Guid id)
    {
        RestoreReport? report = null;
        (_proposal, _proposalSummary) = (null, null);
        Edit("Restore saved plan", p => report = PlanOperations.RestorePlan(p, id));
        if (report!.IsClean)
        {
            Snackbar.Add("The saved plan is now the current plan.", Severity.Success);
            return;
        }
        var notes = new List<string>();
        if (report.GroupsMissing > 0)
            notes.Add($"{report.GroupsMissing} deleted groups were left out");
        if (report.SeatsDropped > 0)
            notes.Add($"{report.SeatsDropped} seats no longer exist");
        if (report.GroupsWithWrongCount.Count > 0)
            notes.Add($"the size changed for {string.Join(", ", report.GroupsWithWrongCount)}");
        Snackbar.Add($"Restored, but the setup has changed since: {string.Join("; ", notes)}. Re-optimize to fix the plan.", Severity.Warning);
    }

    private async Task DeletePlan(Guid id)
    {
        var name = Session.Project!.SavedAssignments.FirstOrDefault(s => s.Id == id)?.Name;
        var confirm = await Dialogs.ShowMessageBoxAsync("Delete saved plan?", $"Delete '{name}'? You can undo this.", yesText: "Delete", cancelText: "Cancel");
        if (confirm == true)
            Edit("Delete saved plan", p => PlanOperations.DeletePlan(p, id));
    }

    /// <summary>Selects a group (or deselects it when clicked again) and shows the floor where it sits.</summary>
    private void HighlightGroup(Guid? groupId)
    {
        if (groupId != _highlight)
            _moving = false;
        _highlight = _highlight == groupId ? null : groupId;
        if (_highlight is { } id && DisplayedAssignment.SeatsOf(id).FirstOrDefault() is { TableId: var tableId } && tableId != Guid.Empty)
            if (Session.Project!.Setup.Floors.FirstOrDefault(f => f.Tables.Any(t => t.Id == tableId)) is { } floor)
                _floorId = floor.Id;
    }

    private void Zoom(double delta) => _scale = Math.Clamp(_scale + delta, MinScale, MaxScale);
}
