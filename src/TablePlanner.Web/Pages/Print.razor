@page "/project/{Id:guid}/print"
@implements IDisposable
@inject ProjectSession Session
@inject TemplateStore Templates
@inject IDialogService Dialogs
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@using TablePlanner.Export.Printing

<PageTitle>Print and share · Table Planner</PageTitle>

<ProjectLoader Id="Id">
    @{ var project = Session.Project!; }
    <div class="editor-page">
        <MudToolBar Dense="true" Class="editor-toolbar" WrapContent="true">
            <MudToggleGroup T="PrintKind" Value="_kind" ValueChanged="SetKind" Size="Size.Small" Color="Color.Primary">
                <MudToggleItem Value="PrintKind.TableCards" Text="Table cards" />
                <MudToggleItem Value="PrintKind.Poster" Text="Poster" />
                <MudToggleItem Value="PrintKind.GuestPage" Text="Guest page" />
            </MudToggleGroup>

            <MudSelect T="Guid" Value="_planId" ValueChanged="SetPlan" Label="Plan" Dense="true" Margin="Margin.Dense"
                       Variant="Variant.Outlined" Class="ml-3 print-option" Style="max-width: 220px">
                <MudSelectItem Value="Guid.Empty">Current plan</MudSelectItem>
                @foreach (var saved in project.SavedAssignments)
                {
                    <MudSelectItem Value="saved.Id">@saved.Name</MudSelectItem>
                }
            </MudSelect>

            @if (_kind == PrintKind.TableCards)
            {
                <MudSelect T="CardsFor" Value="_cards.For" ValueChanged="@(v => SetCards(_cards with { For = v }))" Label="One card per"
                           Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Class="ml-3 print-option" Style="max-width: 200px">
                    <MudSelectItem Value="CardsFor.GroupAtTable">Group at each table</MudSelectItem>
                    <MudSelectItem Value="CardsFor.Seat">Seat</MudSelectItem>
                </MudSelect>
                <MudSelect T="PaperSize" Value="_cards.Paper" ValueChanged="@(v => SetCards(_cards with { Paper = v }))" Label="Paper"
                           Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Class="ml-3 print-option" Style="max-width: 170px">
                    <MudSelectItem Value="PaperSize.A4">A4 (2 cards)</MudSelectItem>
                    <MudSelectItem Value="PaperSize.A5">A5 (1 card)</MudSelectItem>
                </MudSelect>
                <MudTooltip Text="@(_cards.Paper == PaperSize.A5 ? "Tent cards are printed on A4, folded to A5." : "Each A4 sheet is one card, printed twice with the top half upside down: fold it across the middle and it stands on the table.")">
                    <MudSwitch T="bool" Value="_cards.IsFolded" ValueChanged="@(v => SetCards(_cards with { Folded = v }))" Label="Folded tent cards" Color="Color.Primary" Class="ml-3"
                               Disabled="_cards.Paper == PaperSize.A5" />
                </MudTooltip>
                @if (_sheetCount > 0)
                {
                    <MudText Typo="Typo.caption" Class="ml-2 mud-text-secondary">@_cardCount cards · @_sheetCount @_cards.Paper @(_sheetCount == 1 ? "sheet" : "sheets")</MudText>
                }
            }

            @if (_kind == PrintKind.Poster)
            {
                <MudSelect T="PaperSize" Value="_poster.Paper" ValueChanged="@(v => SetPoster(_poster with { Paper = v }))" Label="Paper"
                           Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" Class="ml-3 print-option" Style="max-width: 100px">
                    <MudSelectItem Value="PaperSize.A3">A3</MudSelectItem>
                    <MudSelectItem Value="PaperSize.A4">A4</MudSelectItem>
                </MudSelect>
                <MudSwitch T="bool" Value="_poster.Landscape" ValueChanged="@(v => SetPoster(_poster with { Landscape = v }))" Label="Landscape" Color="Color.Primary" Class="ml-3" />
                <MudCheckBox T="bool" Value="_poster.ShowFloorPlans" ValueChanged="@(v => SetPoster(_poster with { ShowFloorPlans = v }))" Label="Floor plans" Dense="true" />
                <MudCheckBox T="bool" Value="_poster.ShowGroupList" ValueChanged="@(v => SetPoster(_poster with { ShowGroupList = v }))" Label="Group list" Dense="true" />
            }

            @if (IsGuestPage)
            {
                <MudTextField T="string" Value="project.GuestPageUrl" ValueChanged="SetGuestPageUrl" Label="Web address of the guest page"
                              Placeholder="https://…" Margin="Margin.Dense" Variant="Variant.Outlined" Class="ml-3 print-option"
                              Style="min-width: 320px" Error="@(!string.IsNullOrWhiteSpace(project.GuestPageUrl) && !QrCode.IsWebAddress(project.GuestPageUrl))"
                              ErrorText="Use a full address starting with https://" />
            }

            <MudSpacer />
            @if (!IsGuestPage)
            {
                <MudSelect T="double" Value="Zoom" ValueChanged="@(v => _zoom[_kind] = v)" Label="Preview size" Dense="true" Margin="Margin.Dense"
                           Variant="Variant.Outlined" Class="mr-2 print-option" Style="max-width: 120px">
                    @foreach (var zoom in ZoomLevels)
                    {
                        <MudSelectItem Value="zoom">@($"{zoom:P0}")</MudSelectItem>
                    }
                </MudSelect>
            }
            <MudSelect T="Guid" Value="SelectedId" ValueChanged="SelectTemplate" Label="Template" Dense="true" Margin="Margin.Dense"
                       Variant="Variant.Outlined" Class="mr-2 print-option" Style="min-width: 180px; max-width: 240px">
                <MudSelectItem Value="Guid.Empty">@TemplateLibrary.BuiltInName</MudSelectItem>
                @foreach (var saved in _library.For(_kind))
                {
                    <MudSelectItem Value="saved.Id">@saved.Name</MudSelectItem>
                }
            </MudSelect>
            @if (_kind == PrintKind.TableCards)
            {
                <MudTooltip Text="Place the name, table number, colours, a logo or the QR code on the card by dragging">
                    <MudButton Variant="Variant.Text" StartIcon="@Icons.Material.Filled.Brush" Href="@($"project/{Id}/print/card-designer")">Design cards</MudButton>
                </MudTooltip>
            }
            <MudButton Variant="@(_editing ? Variant.Filled : Variant.Text)" StartIcon="@Icons.Material.Filled.Code" OnClick="@(() => _editing = !_editing)">
                @(_editing ? "Close template" : "Edit template")
            </MudButton>
            @if (IsGuestPage)
            {
                <MudTooltip Text="Saves the page as one HTML file. Put it on any web host and share the link, e.g. as a QR code.">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Download" Class="ml-2"
                               Disabled="_html is null" OnClick="DownloadPage">Download page</MudButton>
                </MudTooltip>
            }
            else
            {
                <MudTooltip Text="Opens the browser's print dialog. Choose your printer, or 'Save as PDF'.">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Print" Class="ml-2"
                               Disabled="_html is null" OnClick="PrintAsync">Print</MudButton>
                </MudTooltip>
            }
        </MudToolBar>

        @if (Messages().ToList() is { Count: > 0 } messages)
        {
            <div class="print-messages">
                @foreach (var (severity, text) in messages)
                {
                    <MudAlert Severity="severity" Dense="true" Class="mb-1">@text</MudAlert>
                }
            </div>
        }

        <div class="editor-body">
            @if (_editing)
            {
                <div class="template-side">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Wrap="Wrap.Wrap">
                        <MudText Typo="Typo.subtitle2" Style="flex: 1">
                            @(Selected?.Name ?? $"{TemplateLibrary.BuiltInName} {KindName.ToLowerInvariant()}")
                            @if (Selected?.DesignJson is not null)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Primary">@(Selected.IsUnchangedDesign ? "Card designer" : "Card designer, edited by hand")</MudChip>
                            }
                        </MudText>
                    </MudStack>
                    <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap">
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ContentCopy" OnClick="CopyTemplate">Make a copy</MudButton>
                        @if (Selected is { } saved)
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.DriveFileRenameOutline" OnClick="@(() => RenameTemplate(saved))">Rename</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" OnClick="@(() => DeleteTemplate(saved))">Delete</MudButton>
                        }
                        <MudButton HtmlTag="label" Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Upload" for="template-file">Load</MudButton>
                        <InputFile id="template-file" accept=".html,.htm,text/html" OnChange="LoadTemplate" hidden @key="_fileKey" />
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Download" OnClick="DownloadTemplate">Save to file</MudButton>
                    </MudStack>
                    <MudText Class="mud-text-secondary" Typo="Typo.caption">
                        @if (Selected is null)
                        {
                            @:The built-in template cannot be changed: make a copy and give it a name to edit it.
                        }
                        else
                        {
                            @:HTML and CSS with placeholders such as {{GroupName}}. Changes are saved as you type, in this browser, and used for every project.
                        }
                    </MudText>
                    <MudTextField T="string" Value="Template" ValueChanged="SetTemplate" Lines="22" Variant="Variant.Outlined" ReadOnly="Selected is null"
                                  Immediate="true" DebounceInterval="500" Class="template-editor" spellcheck="false" aria-label="Template HTML" />
                    <MudExpansionPanels Dense="true" Outlined="true">
                        <MudExpansionPanel Text="Placeholders">
                            @PlaceholderList(_kind switch { PrintKind.TableCards => TableCards.Placeholders, PrintKind.Poster => Poster.Placeholders, _ => GuestPage.Placeholders })
                            <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2">
                                {{#List}}…{{/List}} repeats for each item; {{#Flag}}…{{/Flag}} shows only when it is true or not empty,
                                {{^Flag}}…{{/Flag}} only when it is not. {{! … }} is a comment. Scripts run only in the guest page preview.
                            </MudText>
                        </MudExpansionPanel>
                    </MudExpansionPanels>
                </div>
            }
            @* Templates may come from other people. Prints: no scripts; allow-same-origin lets the page call print() on the
               frame and allow-modals lets the frame open the print dialog. The preview size scales the frame, not the
               document, so it does not change what is printed. The guest page needs its script for the search, so it
               runs with scripts but without same-origin: it cannot reach the app or its data. A new frame (@key) is
               made when switching, as a frame keeps its sandbox until it loads a new document. *@
            <div class="print-preview-box @(IsGuestPage ? "phone-preview" : "")">
                @if (IsGuestPage)
                {
                    <iframe @key="PrintKind.GuestPage" class="print-preview" title="Guest page preview" sandbox="allow-scripts" srcdoc="@(_html ?? "")"></iframe>
                    <MudPaper Class="qr-panel pa-3" Outlined="true">
                        <MudText Typo="Typo.subtitle2" GutterBottom="true">QR code</MudText>
                        @if (QrCode.IsWebAddress(project.GuestPageUrl))
                        {
                            @* Our own SVG made from the address, not template content, so it can go in the page as is. *@
                            <div class="qr-preview">@((MarkupString)QrCode.Svg(project.GuestPageUrl!.Trim()))</div>
                            <MudText Typo="Typo.caption" Class="qr-url">@project.GuestPageUrl!.Trim()</MudText>
                            <MudStack Row="true" Spacing="1" Class="mt-2">
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Download" OnClick="@(() => DownloadQr(svg: true))">SVG</MudButton>
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Download" OnClick="@(() => DownloadQr(svg: false))">PNG</MudButton>
                            </MudStack>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2">
                                The poster shows it on the "Find your table" page; templates can use {{GuestPageQr}}.
                                Scan it with a phone to check it before printing.
                            </MudText>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2" Class="mud-text-secondary">
                                Put the downloaded page online, then enter its web address above. You get a QR code to download,
                                and the poster shows it.
                            </MudText>
                        }
                    </MudPaper>
                }
                else
                {
                    <iframe @key="PrintKind.TableCards" @ref="_frame" class="print-preview" title="Print preview" sandbox="allow-same-origin allow-modals" srcdoc="@(_html ?? "")"
                            style="@FormattableString.Invariant($"width: {100 / Zoom:0.##}%; height: {100 / Zoom:0.##}%; transform: scale({Zoom})")"></iframe>
                }
            </div>
        </div>
    </div>
</ProjectLoader>

@code {
    private const long MaxTemplateBytes = 1024 * 1024;
    private static readonly double[] ZoomLevels = [0.25, 0.5, 0.75, 1];

    // An A3 poster page is about 1,600 pixels wide, so it starts at half size.
    private readonly Dictionary<PrintKind, double> _zoom = new() { [PrintKind.TableCards] = 0.75, [PrintKind.Poster] = 0.5, [PrintKind.GuestPage] = 1 };

    private TemplateLibrary _library = new();
    private PrintKind _kind = PrintKind.TableCards;
    private Guid _planId = Guid.Empty;
    private PosterOptions _poster = new();
    private CardOptions _cards = new();
    private int _cardCount, _sheetCount;
    private bool _editing;
    private int _fileKey;
    private ElementReference _frame;

    private string? _html;
    private IReadOnlyList<string> _warnings = [];
    private string? _error;
    private int _notSeated;

    [Parameter] public Guid Id { get; set; }

    private string Template => _library.Html(_kind);

    /// <summary>The selected saved template of the shown kind, or null for the built-in one.</summary>
    private SavedTemplate? Selected => _library.SelectedTemplate(_kind);

    private Guid SelectedId => Selected?.Id ?? Guid.Empty;

    private string KindName => _kind switch { PrintKind.TableCards => "Table cards", PrintKind.Poster => "Poster", _ => "Guest page" };

    private double Zoom => _zoom[_kind];

    private bool IsGuestPage => _kind == PrintKind.GuestPage;


    protected override async Task OnInitializedAsync()
    {
        Session.Changed += OnSessionChanged;
        _library = await Templates.LoadAsync();
        Rebuild();
    }

    public void Dispose() => Session.Changed -= OnSessionChanged;

    private void OnSessionChanged()
    {
        Rebuild();
        InvokeAsync(StateHasChanged);
    }

    private SeatingAssignment? SelectedAssignment(EventProject project) => _planId == Guid.Empty
        ? project.CurrentAssignment
        : project.SavedAssignments.FirstOrDefault(s => s.Id == _planId)?.Assignment;

    /// <summary>Fills the template with the chosen plan. A broken template keeps the last good preview and shows the error.</summary>
    private void Rebuild()
    {
        if (Session.Project is not { } project || project.Id != Id)
            return;
        if (SelectedAssignment(project) is not { } assignment)
        {
            _planId = Guid.Empty;
            assignment = project.CurrentAssignment;
        }

        var plan = new PrintedPlan(project.Setup, assignment);
        _notSeated = project.Setup.Groups.Count(g => g.PeopleCount > 0 && plan.Seated(g) < g.PeopleCount);
        var data = _kind switch
        {
            PrintKind.TableCards => TableCards.BuildData(project.Name, plan, _cards, project.GuestPageUrl),
            PrintKind.Poster => Poster.BuildData(project.Name, plan, _poster, Session.Images, project.GuestPageUrl),
            _ => GuestPage.BuildData(project.Name, plan, Session.Images),
        };
        (_cardCount, _sheetCount) = _kind == PrintKind.TableCards ? ((int)data["CardCount"]!, (int)data["SheetCount"]!) : (0, 0);
        try
        {
            var result = HtmlTemplate.Render(Template, data);
            _html = result.Html;
            _warnings = result.Warnings;
            _error = null;
        }
        catch (TemplateFormatException ex)
        {
            _error = ex.Message;
            _warnings = [];
        }
    }

    private IEnumerable<(Severity, string)> Messages()
    {
        var project = Session.Project!;
        if (SelectedAssignment(project) is { Seats.Count: 0 })
            yield return (Severity.Info, "No groups are seated in this plan yet. Make a plan on the Plan page first.");
        else if (_notSeated > 0)
            yield return (Severity.Warning, $"{_notSeated} {(_notSeated == 1 ? "group is" : "groups are")} not fully seated; only seated people are printed.");
        if (_error is not null)
            yield return (Severity.Error, $"The template could not be read. {_error} The preview shows the last version that worked.");
        foreach (var warning in _warnings)
            yield return (Severity.Warning, warning);
    }

    private void SetKind(PrintKind kind)
    {
        _kind = kind;
        Rebuild();
    }

    private void SetPlan(Guid id)
    {
        _planId = id;
        Rebuild();
    }

    private void SetCards(CardOptions options)
    {
        _cards = options;
        Rebuild();
    }

    private void SetPoster(PosterOptions options)
    {
        _poster = options;
        Rebuild();
    }

    private async Task SetTemplate(string text)
    {
        // Only saved templates can be edited; the built-in one is read-only.
        if (Selected is not { } saved || saved.Html == text)
            return;
        saved.Html = text;
        saved.SavedAt = DateTimeOffset.Now;
        await StoreLibrary();
        Rebuild();
    }

    private async Task SelectTemplate(Guid id)
    {
        _library.Select(_kind, id == Guid.Empty ? null : id);
        await StoreLibrary();
        Rebuild();
    }

    private async Task StoreLibrary()
    {
        try
        {
            await Templates.SaveAsync(_library);
        }
        catch (JSException)
        {
            Snackbar.Add("The templates could not be saved: browser storage is full.", Severity.Error);
        }
    }

    private async Task<string?> AskName(string title, string name, string? message = null, string okText = "Save")
    {
        var dialog = await Dialogs.ShowAsync<NameDialog>(title,
            new DialogParameters<NameDialog> { { x => x.Name, name }, { x => x.Message, message }, { x => x.OkText, okText } },
            new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true });
        return await dialog.Result is { Canceled: false, Data: string chosen } ? chosen : null;
    }

    /// <summary>Saves the shown template (built-in or saved) under a new name and uses it, so it can be edited.</summary>
    private async Task CopyTemplate()
    {
        var suggested = Selected is { } saved ? $"{saved.Name} (copy)" : $"My {KindName.ToLowerInvariant()}";
        if (await AskName("Make a copy", _library.UniqueName(_kind, suggested),
                "The copy is used from now on and can be edited. The original stays as it is.", "Make a copy") is not { } name)
            return;
        _library.Add(_kind, name, Template, DateTimeOffset.Now, Selected?.DesignJson);
        _editing = true;
        await StoreLibrary();
        Rebuild();
    }

    private async Task RenameTemplate(SavedTemplate saved)
    {
        if (await AskName("Rename template", saved.Name, okText: "Rename") is not { } name)
            return;
        _library.Rename(saved.Id, name);
        await StoreLibrary();
    }

    private async Task DeleteTemplate(SavedTemplate saved)
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync("Delete template?",
            $"Delete '{saved.Name}'? This can't be undone. Save it to a file first if you may need it again.",
            yesText: "Delete", cancelText: "Cancel");
        if (confirmed != true)
            return;
        _library.Delete(saved.Id);
        await StoreLibrary();
        Rebuild();
    }

    /// <summary>A template from a file is saved under the file's name and used.</summary>
    private async Task LoadTemplate(InputFileChangeEventArgs e)
    {
        _fileKey++;
        string html;
        try
        {
            using var reader = new StreamReader(e.File.OpenReadStream(MaxTemplateBytes));
            html = await reader.ReadToEndAsync();
        }
        catch (IOException ex)
        {
            Snackbar.Add($"Could not read the file: {ex.Message}", Severity.Error);
            return;
        }
        var saved = _library.Add(_kind, Path.GetFileNameWithoutExtension(e.File.Name), html, DateTimeOffset.Now);
        await StoreLibrary();
        Rebuild();
        Snackbar.Add($"Template loaded from {e.File.Name} and saved as '{saved.Name}'.", Severity.Success);
    }

    private async Task DownloadTemplate()
    {
        var fileName = Selected is { } saved
            ? $"{Formatting.FileName(saved.Name)}.html"
            : _kind switch { PrintKind.TableCards => "table-cards-template.html", PrintKind.Poster => "poster-template.html", _ => "guest-page-template.html" };
        await JS.InvokeVoidAsync("tablePlanner.downloadFile", fileName, "text/html", Template);
    }

    private void SetGuestPageUrl(string? url)
    {
        var value = string.IsNullOrWhiteSpace(url) ? null : url.Trim();
        if (value != Session.Project!.GuestPageUrl)
            Session.History!.Execute("Set guest page address", p => p.GuestPageUrl = value);
    }

    private async Task DownloadQr(bool svg)
    {
        var url = Session.Project!.GuestPageUrl!.Trim();
        var name = $"{GuestPageSlug()}-qr-code";
        if (svg)
            await JS.InvokeVoidAsync("tablePlanner.downloadFile", $"{name}.svg", "image/svg+xml", QrCode.Svg(url));
        else
            await JS.InvokeVoidAsync("tablePlanner.downloadFile", $"{name}.png", "image/png", QrCode.Png(url));
    }

    /// <summary>The project's name without spaces or capitals, since file names become part of web addresses.</summary>
    private string GuestPageSlug()
    {
        var slug = System.Text.RegularExpressions.Regex.Replace(Session.Project!.Name.ToLowerInvariant(), @"[^\p{L}\p{N}]+", "-").Trim('-');
        return slug.Length == 0 ? "event" : slug;
    }

    private async Task DownloadPage()
    {
        var fileName = $"{GuestPageSlug()}-find-your-table.html";
        await JS.InvokeVoidAsync("tablePlanner.downloadFile", fileName, "text/html", _html);
    }

    private async Task PrintAsync() => await JS.InvokeVoidAsync("tablePlanner.printFrame", _frame);

    private static RenderFragment PlaceholderList(IReadOnlyList<Placeholder> placeholders) => __builder =>
    {
        <ul class="placeholder-list">
            @foreach (var placeholder in placeholders)
            {
                <li>
                    <code>@(placeholder.Items is null ? $"{{{{{placeholder.Name}}}}}" : $"{{{{#{placeholder.Name}}}}}…{{{{/{placeholder.Name}}}}}")</code>
                    <span>@placeholder.Description</span>
                    @if (placeholder.Items is { } items)
                    {
                        @PlaceholderList(items)
                    }
                </li>
            }
        </ul>
    };
}
