@* Totals, preference fulfilment, issues and the group list for a plan. Clicking a group highlights it. *@
@using TablePlanner.Solver

<MudText Typo="Typo.subtitle1">@(Summary.PeoplePlaced == 0 ? "No plan yet" : "Plan")</MudText>
@if (Summary.PeoplePlaced == 0)
{
    <MudText Typo="Typo.body2" Class="mb-2">Press <b>Make plan</b> to seat the groups.</MudText>
}
else
{
    <MudSimpleTable Dense="true" Elevation="0" Class="mb-2 summary-table">
        <tbody>
            <tr><td>People seated</td><td>@Summary.PeoplePlaced of @Summary.PeopleTotal</td></tr>
            <tr><td>Groups split over tables</td><td>@Summary.SplitGroups of @Summary.Groups.Count</td></tr>
            @foreach (var stat in Summary.PreferenceStats)
            {
                <tr><td>@Formatting.Ordinal(stat.Rank) choices met</td><td>@stat.Met of @stat.Wanted</td></tr>
            }
        </tbody>
    </MudSimpleTable>
}

@if (Summary.PeoplePlaced > 0 && Issues() is { Count: > 0 } issues)
{
    <MudAlert Severity="@(issues.Any(i => i.Severity == Core.Validation.IssueSeverity.Error) ? Severity.Error : Severity.Warning)" Dense="true" Class="mb-2">
        <ul class="message-list">
            @foreach (var issue in issues.Take(_showAllIssues ? int.MaxValue : MaxIssues))
            {
                @* A warning about a group selects that group, as clicking it in the list does. *@
                if (issue.GroupId is { } groupId)
                {
                    <li class="issue-link @(Highlight == groupId ? "highlighted" : "")" title="Click to select the group"
                        @onclick="() => HighlightChanged.InvokeAsync(groupId)">@issue.Message</li>
                }
                else
                {
                    <li>@issue.Message</li>
                }
            }
            @if (issues.Count > MaxIssues)
            {
                <li>
                    <MudLink Typo="Typo.body2" OnClick="() => _showAllIssues = !_showAllIssues">
                        @(_showAllIssues ? "Show fewer" : $"… and {issues.Count - MaxIssues} more")
                    </MudLink>
                </li>
            }
        </ul>
    </MudAlert>
}

<MudStack Row="true" AlignItems="AlignItems.Center" Class="mt-1">
    <MudText Typo="Typo.subtitle2">@(ShowLevel > 0 ? $"Groups – level {ShowLevel}" : "Groups")</MudText>
    <MudSpacer />
    <MudTextField T="string" @bind-Value="_search" Placeholder="Find a group or person" Immediate="true" Clearable="true"
                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Margin="Margin.Dense" Style="max-width: 220px" />
</MudStack>
<div class="group-list">
    @foreach (var (group, parent, level) in Rows())
    {
        @if (parent is not null)
        {
            @* A parent group (department, team with subteams): click to select all its groups; not dragged. *@
            var parentId = parent.GroupId;
            <div class="group-row parent-row @(Highlight == parentId ? "highlighted" : "")" style="padding-left: @((level - 1) * 14 + 4)px"
                 @onclick="() => HighlightChanged.InvokeAsync(parentId)">
                @if (ShowLevel == 0 && Search is null)
                {
                    @* Fold the parent's groups open or shut (without selecting it). *@
                    <span class="fold" @onclick="() => Fold(parentId)" @onclick:stopPropagation="true" title="@(_folded.Contains(parentId) ? "Show its groups" : "Hide its groups")">
                        <MudIcon Icon="@(_folded.Contains(parentId) ? Icons.Material.Filled.ChevronRight : Icons.Material.Filled.ExpandMore)" Size="Size.Small" />
                    </span>
                }
                <span class="group-dot" style="background: @Colours.GetValueOrDefault(parentId, "#ccc")"></span>
                <span class="group-name"><b>@parent.Name</b> <span class="group-count">(@parent.PeopleCount)</span></span>
                <span class="group-tables" title="@TablesTitle(parent.TableNumbers)">
                    @if (parent.IsSpread)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Warning" Inline="true">@parent.PeopleApart apart · </MudText>
                    }
                    @TableNumberText.Format(parent.TableNumbers)
                </span>
            </div>
            continue;
        }
        var id = group!.GroupId;
        @* Rows can be dragged onto the floor plan (the browser's own drag and drop; see app.js for the drag data). *@
        <div class="group-row @(Highlight == id ? "highlighted" : "")" style="@(level > 1 ? $"padding-left: {(level - 1) * 14 + 4}px" : null)" @onclick="() => HighlightChanged.InvokeAsync(id)"
             draggable="@(DragEnabled ? "true" : "false")" data-drag-group="@(DragEnabled ? "true" : null)"
             @ondragstart="() => DragStarted.InvokeAsync(id)" @ondragend="() => DragEnded.InvokeAsync()"
             title="@(DragEnabled ? "Click to select, or drag onto a seat of the floor plan" : null)">
            <span class="group-dot" style="background: @Colours.GetValueOrDefault(id, "#ccc")"></span>
            <span class="group-name">@group.Name <span class="group-count">(@group.PeopleCount)</span>
                @if (FoundNames(id) is { Count: > 0 } found)
                {
                    <span class="found-names">· @string.Join(", ", found)</span>
                }
            </span>
            @if (Pinned.Contains(id))
            {
                <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Class="mud-text-secondary" Title="Locked or pinned" />
            }
            <span class="group-tables" title="@TablesTitle(group.TableNumbers)">
                @if (group.Placed == 0)
                {
                    <MudText Typo="Typo.caption" Color="Color.Warning">No seats</MudText>
                }
                else
                {
                    @TableNumberText.Format(group.TableNumbers)
                    @if (!group.IsPlaced)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Warning" Inline="true"> · @group.Placed seated</MudText>
                    }
                }
            </span>
        </div>
    }
</div>

@code {
    /// <summary>The full list as a tooltip, for when it is cut short in the row.</summary>
    private static string? TablesTitle(IReadOnlyList<int> tables) =>
        tables.Count > 1 ? $"Tables {string.Join(", ", tables.Order())}" : null;

    private const int MaxIssues = 6;

    private bool _showAllIssues;

    [Parameter, EditorRequired] public PlanSummary Summary { get; set; } = default!;

    /// <summary>The setup, for group levels: the list is then a tree with the parent groups. Optional.</summary>
    [Parameter] public EventSetup? Setup { get; set; }

    private string? _search;

    private string? Search => string.IsNullOrWhiteSpace(_search) ? null : _search.Trim();

    /// <summary>Names in a group that match the search (none without a search).</summary>
    private List<string> FoundNames(Guid groupId) =>
        Search is { } s && Setup?.FindGroup(groupId) is { } g
            ? g.Members.Where(m => m.Name.Contains(s, StringComparison.CurrentCultureIgnoreCase)).Select(m => m.Name).ToList()
            : [];

    /// <summary>The rows, narrowed by the search to groups whose name or people match, and the parent groups above them.</summary>
    private IEnumerable<(GroupPlacement? Group, ParentPlacement? Parent, int Level)> Rows()
    {
        var rows = AllRows().ToList();
        if (Search is not { } s)
            return rows;
        bool NameMatches(string name) => name.Contains(s, StringComparison.CurrentCultureIgnoreCase);
        var found = rows.Where(r => r.Group is { } g && (NameMatches(g.Name) || FoundNames(g.GroupId).Count > 0))
            .Select(r => r.Group!.GroupId).ToHashSet();
        return rows.Where(r => r.Group is { } g
            ? found.Contains(g.GroupId)
            : NameMatches(r.Parent!.Name) || (Setup?.FindGroup(r.Parent.GroupId) is { } p && Setup.BottomGroupsOf(p).Any(b => found.Contains(b.Id))));
    }

    /// <summary>
    /// Which groups the list shows: 0 all of them (a tree, with levels); 1, 2, … only the groups at that level (each
    /// seated group counted in its group at that level; one without that many levels counts as itself).
    /// </summary>
    [Parameter] public int ShowLevel { get; set; }

    /// <summary>The groups at <see cref="ShowLevel"/> (null when showing all).</summary>
    private HashSet<Guid>? LevelGroups() => ShowLevel > 0 && Setup is { } setup
        ? Summary.Groups.Select(g => setup.FindGroup(g.GroupId)).OfType<Group>().Select(g => setup.AtLevel(g, ShowLevel).Id).ToHashSet()
        : null;

    /// <summary>The warnings to show: all of them, or with a level chosen those about its groups (and the general ones).</summary>
    private IReadOnlyList<PlanIssue> Issues() => LevelGroups() is { } level
        ? Summary.Issues.Where(i => i.GroupId is not { } g || level.Contains(g)).ToList()
        : Summary.Issues;

    // Parent groups folded shut in the tree.
    private readonly HashSet<Guid> _folded = [];

    private void Fold(Guid parentId)
    {
        if (!_folded.Remove(parentId))
            _folded.Add(parentId);
    }

    /// <summary>
    /// The rows of the group list: without levels the groups by name; with levels in tree order, parent groups (with
    /// seated groups) included, leaving out what is folded shut; with a level chosen, the groups at that level by name.
    /// </summary>
    private IEnumerable<(GroupPlacement? Group, ParentPlacement? Parent, int Level)> AllRows()
    {
        if (Setup is not { } setup || Summary.ParentGroups.Count == 0)
        {
            foreach (var g in Summary.Groups.OrderBy(g => g.Name, StringComparer.CurrentCultureIgnoreCase))
                yield return (g, null, 1);
            yield break;
        }
        var groups = Summary.Groups.ToDictionary(g => g.GroupId);
        var parents = Summary.ParentGroups.ToDictionary(p => p.GroupId);
        if (LevelGroups() is { } level)
        {
            var names = level.Select(id => (Id: id, Name: setup.FindGroup(id)?.Name ?? "")).OrderBy(x => x.Name, StringComparer.CurrentCultureIgnoreCase);
            foreach (var (id, _) in names)
                if (groups.TryGetValue(id, out var placement))
                    yield return (placement, null, 1);
                else if (parents.TryGetValue(id, out var parent))
                    yield return (null, parent, 1);
            yield break;
        }
        foreach (var (group, depth) in setup.InTreeOrder())
        {
            if (Search is null && setup.AncestorsOf(group).Any(a => _folded.Contains(a.Id)))
                continue;
            if (groups.TryGetValue(group.Id, out var placement))
                yield return (placement, null, depth);
            else if (parents.TryGetValue(group.Id, out var parent))
                yield return (null, parent, depth);
        }
    }
    [Parameter, EditorRequired] public IReadOnlyDictionary<Guid, string> Colours { get; set; } = default!;
    [Parameter] public IReadOnlySet<Guid> Pinned { get; set; } = new HashSet<Guid>();
    [Parameter] public Guid? Highlight { get; set; }
    [Parameter] public EventCallback<Guid?> HighlightChanged { get; set; }

    /// <summary>When on, groups can be dragged from the list onto the floor plan.</summary>
    [Parameter] public bool DragEnabled { get; set; }

    [Parameter] public EventCallback<Guid> DragStarted { get; set; }

    /// <summary>The drag ended, dropped or not.</summary>
    [Parameter] public EventCallback DragEnded { get; set; }
}
