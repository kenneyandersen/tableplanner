@* Draws one floor with a seating plan: seats coloured by group and group names on their part of each table.
   It does not change the plan itself: seat and label clicks, and groups dragged onto a seat, are reported to the
   page, which selects, moves or swaps groups. Coordinates are metres; Scale is pixels per metre. *@
@inject IJSRuntime JS
@using static TablePlanner.Web.Formatting

@if (Floor is { } floor)
{
    var extent = CanvasExtent.Of(floor);
    var (width, height) = (extent.Width, extent.Height);
    _origin = new Point(extent.Left, extent.Top);
    <svg @ref="_svg" class="floor-canvas plan-canvas @(MoveMode ? "move-mode" : "") @(_drag is { Started: true } ? "dragging" : "")"
         width="@Svg(width * Scale)" height="@Svg(height * Scale)" viewBox="@Svg(extent.Left) @Svg(extent.Top) @Svg(width) @Svg(height)"
         @onclick="OnBackgroundClick" @onpointermove="OnPointerMove" @onpointerup="OnPointerUp" @onpointercancel="CancelDrag"
         @ondragenter="OnListDragEnter" @ondragover="OnListDragOver" @ondragover:preventDefault="ListDrag is not null" @ondrop="OnListDrop">
        <defs>
            <pattern id="plan-grid" width="5" height="5" patternUnits="userSpaceOnUse">
                <path d="M 5 0 L 0 0 0 5" class="grid-major" />
            </pattern>
        </defs>
        <rect class="pan-surface" x="@Svg(extent.Left)" y="@Svg(extent.Top)" width="@Svg(width)" height="@Svg(height)" fill="url(#plan-grid)" />

        @if (floor.Background is { } background && BackgroundUrl is { } url)
        {
            <image class="background-image locked" href="@url" preserveAspectRatio="none" opacity="@Svg(background.Opacity)"
                   x="@Svg(background.X)" y="@Svg(background.Y)" width="@Svg(background.Width)" height="@Svg(background.Height)" />
        }

        @* Walls (only a drawing), under everything else. *@
        @((MarkupString)WallDrawing.Svg(floor, "plan-" + floor.Id.ToString("N")))

        @foreach (var element in floor.Elements)
        {
            var bounds = FloorElementGeometry.GetBounds(element);
            var label = ElementDrawing.Label(element);
            <g class="element kind-@element.Kind.ToString().ToLowerInvariant() @(element.IsRound ? "round" : "")">
                @{ var box = FloorElementGeometry.Unturned(element); }
                <rect x="@Svg(box.Left)" y="@Svg(box.Top)" width="@Svg(box.Width)" height="@Svg(box.Height)" rx="0.05" fill="@ElementDrawing.Fill(element.Kind)" transform="@FloorElementGeometry.Transform(element)" />
                @((MarkupString)ElementDrawing.Svg(element))
                <text x="@Svg(label.X)" y="@Svg(label.Y)" font-size="@Svg(label.FontSize)"
                      stroke="@ElementDrawing.HaloColour(element)" stroke-width="@Svg(ElementDrawing.HaloWidth(label.FontSize))" stroke-linejoin="round" paint-order="stroke">@element.Label</text>
            </g>
        }

        @foreach (var table in floor.Tables)
        {
            var bounds = TableGeometry.GetBounds(table);
            var seats = TableGeometry.GetSeats(table);
            <g class="table">
                <rect x="@Svg(bounds.Left)" y="@Svg(bounds.Top)" width="@Svg(bounds.Width)" height="@Svg(bounds.Height)" rx="@Svg(TableGeometry.CornerRadius(table))" />
                @foreach (var seat in seats)
                {
                    var groupId = _groupAt.GetValueOrDefault(seat.Id);
                    var group = groupId == Guid.Empty ? null : Setup.FindGroup(groupId);
                    var dimmed = Selected is not null && !IsSelected(groupId) && !MoveMode && _drag is not { Started: true };
                    var seatId = seat.Id;
                    <circle cx="@Svg(seat.Position.X)" cy="@Svg(seat.Position.Y)" r="0.22"
                            class="seat @(seat.IsDisabled ? "disabled" : "") @(group is null ? "empty" : "taken") @(dimmed ? "dimmed" : "") @(group is not null && IsSelected(groupId) ? "highlighted" : "") @(group is not null && Pinned.Contains(groupId) ? "pinned" : "") @DropClass(seatId)"
                            style="@(group is null ? null : $"fill: {Colours.GetValueOrDefault(groupId, "#ccc")}")"
                            @onclick="() => SeatClicked.InvokeAsync(seatId)" @onclick:stopPropagation="true"
                            @onpointerdown="e => OnGroupPointerDown(e, group?.Id, seatId)">
                        <title>@(seat.IsDisabled ? $"Table {table.Number}, seat not available" : SeatTitle(table, group))</title>
                    </circle>
                    @if (seat.IsDisabled)
                    {
                        @* Not available (set in the layout editor): crossed out, as there. *@
                        <path d="M @Svg(seat.Position.X - 0.12) @Svg(seat.Position.Y - 0.12) l 0.24 0.24 m 0 -0.24 l -0.24 0.24" class="seat-cross" />
                    }
                }
                @{ var numberAt = GroupLabels.TableNumberPosition(table); }
                <text class="table-number" x="@Svg(numberAt.X)" y="@Svg(numberAt.Y)" font-size="@Svg(GroupLabels.TableNumberFontSize)">@table.Number</text>
                @foreach (var block in GroupLabels.For(table, seats, _labelAt, Setup))
                {
                    var dimmed = Selected is not null && Selected != block.GroupId && !IsSelected(block.GroupId) && !MoveMode;
                    // A parent group's label (when a level is shown) selects it, but is not dragged: its groups are moved one by one.
                    var draggable = !Setup.HasChildren(block.GroupId);
                    @* Wrapped in <g>: a <text> element directly in a code block would be Razor's own <text> tag. *@
                    <g class="group-label @(dimmed ? "dimmed" : "")" @onclick="() => GroupClicked.InvokeAsync(block.GroupId)" @onclick:stopPropagation="true"
                       @onpointerdown="e => OnGroupPointerDown(e, draggable ? block.GroupId : null)">
                        <text x="@Svg(block.Position.X)" y="@Svg(block.Position.Y)" font-size="@Svg(block.FontSize)"
                              transform="@(block.Vertical ? $"rotate(90 {Svg(block.Position.X)} {Svg(block.Position.Y)})" : null)">@block.Text</text>
                    </g>
                }
            </g>
        }

        @* The dragged group (or person) follows the pointer; drawn last so it is on top. *@
        @if (_drag is { Started: true, At: { } at } drag && Setup.FindGroup(drag.GroupId) is { } dragged)
        {
            <g class="drag-ghost">
                <circle cx="@Svg(at.X)" cy="@Svg(at.Y)" r="@(drag.FromSeat is null ? "0.3" : "0.22")" style="fill: @Colours.GetValueOrDefault(dragged.Id, "#ccc")" />
                <text x="@Svg(at.X + 0.45)" y="@Svg(at.Y)" font-size="0.32">@(drag.FromSeat is null ? $"{dragged.Name} ({dragged.PeopleCount})" : $"1 of {dragged.Name}")</text>
            </g>
        }
    </svg>
}

@code {
    private Dictionary<SeatId, Guid> _groupAt = [];
    private Dictionary<SeatId, Guid> _labelAt = [];

    /// <summary>0: each group's name on its seats; 1, 2, …: the names of the groups at that level (e.g. departments).</summary>
    [Parameter] public int ShowLevel { get; set; }

    [Parameter, EditorRequired] public EventSetup Setup { get; set; } = default!;
    [Parameter, EditorRequired] public Guid FloorId { get; set; }
    [Parameter, EditorRequired] public SeatingAssignment Assignment { get; set; } = default!;
    [Parameter, EditorRequired] public IReadOnlyDictionary<Guid, string> Colours { get; set; } = default!;

    /// <summary>The floor's background image as a data URL, or null when there is none.</summary>
    [Parameter] public string? BackgroundUrl { get; set; }

    /// <summary>Pixels per metre.</summary>
    [Parameter] public double Scale { get; set; } = 40;

    /// <summary>The selected group: drawn in full colour while the others are dimmed (see <see cref="SelectedGroups"/>).</summary>
    [Parameter] public Guid? Selected { get; set; }

    /// <summary>The seated groups drawn as selected: for a selected parent group all groups below it. Null: just <see cref="Selected"/>.</summary>
    [Parameter] public IReadOnlySet<Guid>? SelectedGroups { get; set; }

    private bool IsSelected(Guid groupId) => SelectedGroups?.Contains(groupId) ?? Selected == groupId;

    /// <summary>Groups that are locked or pinned, drawn with a dashed outline.</summary>
    [Parameter] public IReadOnlySet<Guid> Pinned { get; set; } = new HashSet<Guid>();

    /// <summary>While moving a group: nothing is dimmed and seats show a "place here" cursor.</summary>
    [Parameter] public bool MoveMode { get; set; }

    [Parameter] public EventCallback<SeatId> SeatClicked { get; set; }

    /// <summary>A group's label was clicked, or the background (null).</summary>
    [Parameter] public EventCallback<Guid?> GroupClicked { get; set; }

    /// <summary>When on, groups can be dragged by a seat or their name onto another seat.</summary>
    [Parameter] public bool DragEnabled { get; set; }

    /// <summary>
    /// Where a group would sit if dropped on a seat (shown while dragging), or null when it cannot go there.
    /// </summary>
    [Parameter] public Func<Guid, SeatId, IReadOnlyCollection<SeatId>?>? DropPreview { get; set; }

    /// <summary>A group was dragged onto a seat.</summary>
    [Parameter] public EventCallback<(Guid GroupId, SeatId Seat)> GroupDropped { get; set; }

    /// <summary>One person was dragged (Shift+drag) from a seat onto another, empty or taken.</summary>
    [Parameter] public EventCallback<(SeatId From, SeatId To)> PersonDropped { get; set; }

    /// <summary>A group being dragged from the group list (with the browser's drag and drop); the plan is its drop zone.</summary>
    [Parameter] public Guid? ListDrag { get; set; }

    /// <summary>A press only becomes a drag after the pointer moves this far (pixels), so clicks still select.</summary>
    private const double DragThreshold = 5;

    /// <summary>A drop counts on a seat when the pointer is within this distance of its centre (metres).</summary>
    private const double DropRadius = 0.4;

    private sealed class DragState(Guid groupId, double startX, double startY, long pointerId)
    {
        public Guid GroupId { get; } = groupId;

        /// <summary>Set when only the one person at this seat is dragged (Shift+drag), not the whole group.</summary>
        public SeatId? FromSeat { get; init; }
        public double StartX { get; } = startX;
        public double StartY { get; } = startY;
        public long PointerId { get; } = pointerId;
        public bool Started { get; set; }
        public Point? At { get; set; }
        public SeatId? Target { get; set; }
        public HashSet<SeatId>? Preview { get; set; }
        public bool IsListDrag { get; init; }
    }

    private ElementReference _svg;
    private Point _origin;
    private DragState? _drag;
    private bool _justDropped;
    private bool _render = true;
    private List<(SeatId Id, Point Position)> _seats = [];

    /// <summary>The SVG's top-left corner on the screen, read when a list drag enters it.</summary>
    private (double Left, double Top)? _screenOrigin;

    private Floor? Floor => Setup.Floors.FirstOrDefault(f => f.Id == FloorId);

    protected override void OnParametersSet()
    {
        if (ListDrag is null && _drag is { IsListDrag: true })
            _drag = null;
        _groupAt = Assignment.Seats.GroupBy(s => s.Seat).ToDictionary(g => g.Key, g => g.First().GroupId);
        // With a level shown, the names on the tables are those of the groups at that level.
        _labelAt = ShowLevel > 0
            ? _groupAt.ToDictionary(x => x.Key, x => Setup.FindGroup(x.Value) is { } g ? Setup.AtLevel(g, ShowLevel).Id : x.Value)
            : _groupAt;
        _seats = Floor?.Tables.SelectMany(TableGeometry.GetSeats).Where(s => !s.IsDisabled).Select(s => (s.Id, s.Position)).ToList() ?? [];
        _render = true;
    }

    // Pointer moves arrive all the time; the floor is drawn again only when something on it changes.
    protected override bool ShouldRender()
    {
        var render = _render;
        _render = true;
        return render;
    }

    private string DropClass(SeatId seat) => _drag switch
    {
        { Started: true, Preview: { } preview } when preview.Contains(seat) => "drop-target",
        { Started: true, Preview: null, Target: { } target } when target == seat => "drop-invalid",
        _ => "",
    };

    private void OnGroupPointerDown(PointerEventArgs e, Guid? groupId, SeatId? seat = null)
    {
        _render = false;
        if (e.Button != 0 || !DragEnabled || groupId is not { } id)
            return;
        // Shift on a seat drags only that person.
        _drag = new DragState(id, e.ClientX, e.ClientY, e.PointerId) { FromSeat = e.ShiftKey ? seat : null };
    }

    private string SeatTitle(Table table, Group? group) =>
        group is null ? $"Table {table.Number}, empty seat"
        : $"{group.Name} ({group.PeopleCount}) · table {table.Number}" + (DragEnabled ? "\nDrag to move the group, Shift+drag to move only this person" : "");

    /// <summary>Where one dragged person would go: the seat itself, unless it is their own or their group's.</summary>
    private HashSet<SeatId>? PersonPreview(DragState drag, SeatId target) =>
        target != drag.FromSeat && _groupAt.GetValueOrDefault(target) != drag.GroupId ? [target] : null;

    private async Task OnPointerMove(PointerEventArgs e)
    {
        _render = false;
        if (_drag is not { } drag)
            return;
        if (!drag.Started)
        {
            if (Math.Abs(e.ClientX - drag.StartX) < DragThreshold && Math.Abs(e.ClientY - drag.StartY) < DragThreshold)
                return;
            // From now on the SVG gets every move (so OffsetX/Y are relative to it), even outside its area.
            drag.Started = true;
            _render = true;
            await JS.InvokeVoidAsync("tablePlanner.capturePointer", _svg, drag.PointerId);
            return;
        }

        _render = Track(drag, new Point(_origin.X + e.OffsetX / Scale, _origin.Y + e.OffsetY / Scale));
    }

    /// <summary>Follows the dragged group to <paramref name="at"/>. True when the plan should be drawn again.</summary>
    private bool Track(DragState drag, Point at)
    {
        var moved = drag.At is not { } last || Math.Abs(last.X - at.X) + Math.Abs(last.Y - at.Y) > 0.05;
        drag.At = at;
        var target = NearestSeat(at);
        if (target != drag.Target)
        {
            drag.Target = target;
            drag.Preview = target is not { } seat ? null
                : drag.FromSeat is not null ? PersonPreview(drag, seat)
                : DropPreview?.Invoke(drag.GroupId, seat) is { } seats ? [.. seats] : null;
            moved = true;
        }
        return moved;
    }

    // A group dragged from the list: drag events carry screen positions, converted with the SVG's position on screen.
    private async Task OnListDragEnter(DragEventArgs e)
    {
        _render = false;
        if (ListDrag is not { } groupId)
            return;
        if (_drag is not { IsListDrag: true })
            _drag = new DragState(groupId, e.ClientX, e.ClientY, 0) { Started = true, IsListDrag = true };
        var origin = await JS.InvokeAsync<double[]>("tablePlanner.elementOrigin", _svg);
        _screenOrigin = (origin[0], origin[1]);
    }

    private void OnListDragOver(DragEventArgs e)
    {
        _render = false;
        if (_drag is { IsListDrag: true } drag && ToFloor(e) is { } at)
            _render = Track(drag, at);
    }

    private async Task OnListDrop(DragEventArgs e)
    {
        if (_drag is not { IsListDrag: true } drag)
            return;
        // The drop has its own position: the last dragover may be a little behind the pointer.
        if (ToFloor(e) is { } at)
            Track(drag, at);
        _drag = null;
        if (drag.Target is { } seat)
            await GroupDropped.InvokeAsync((drag.GroupId, seat));
    }

    private async Task OnPointerUp(PointerEventArgs e)
    {
        if (_drag is not { Started: true } drag)
        {
            _drag = null;
            _render = false;
            return;
        }
        _drag = null;
        // The click that follows a drag lands on the SVG itself; it must not deselect.
        _justDropped = true;
        if (drag.FromSeat is { } from)
        {
            if (drag is { Target: { } to, Preview: not null })
                await PersonDropped.InvokeAsync((from, to));
        }
        else if (drag.Target is { } seat)
            await GroupDropped.InvokeAsync((drag.GroupId, seat));
    }

    private void CancelDrag()
    {
        _render = _drag is { Started: true };
        _drag = null;
    }

    private async Task OnBackgroundClick()
    {
        if (_justDropped)
        {
            _justDropped = false;
            _render = false;
            return;
        }
        await GroupClicked.InvokeAsync(null);
    }

    private Point? ToFloor(DragEventArgs e) => _screenOrigin is { } screen
        ? new Point(_origin.X + (e.ClientX - screen.Left) / Scale, _origin.Y + (e.ClientY - screen.Top) / Scale)
        : null;

    private SeatId? NearestSeat(Point at)
    {
        SeatId? best = null;
        var bestDistance = DropRadius * DropRadius;
        foreach (var (id, position) in _seats)
        {
            var d = (position.X - at.X) * (position.X - at.X) + (position.Y - at.Y) * (position.Y - at.Y);
            if (d <= bestDistance)
                (best, bestDistance) = (id, d);
        }
        return best;
    }
}
