<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <!-- Compile to WebAssembly ahead of time when publishing (needs the wasm-tools workload). The solver runs about
         17 times faster in the browser; publishing takes several minutes and the download grows from ~3 to ~8 MB. -->
    <RunAOTCompilation Condition="'$(Configuration)' == 'Release'">true</RunAOTCompilation>
  </PropertyGroup>

  <!-- Build information shown in the app (BuildInfo): the version and commit are passed by the deploy workflow
       (publish.ps1 -Version/-Commit); a local build has only its build time. -->
  <ItemGroup>
    <AssemblyMetadata Include="BuildTime" Value="$([System.DateTime]::UtcNow.ToString('s'))Z" />
    <AssemblyMetadata Include="BuildVersion" Value="$(BuildVersion)" />
    <AssemblyMetadata Include="BuildCommit" Value="$(BuildCommit)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.11" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.11" PrivateAssets="all" />
    <PackageReference Include="MudBlazor" Version="9.12.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TablePlanner.Core\TablePlanner.Core.csproj" />
    <ProjectReference Include="..\TablePlanner.Solver\TablePlanner.Solver.csproj" />
    <ProjectReference Include="..\TablePlanner.Export\TablePlanner.Export.csproj" />
  </ItemGroup>

</Project>
